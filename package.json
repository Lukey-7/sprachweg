{
  "name": "sprachweg",
  "version": "1.0.0",
  "private": true,
  "description": "Production-quality German learning platform powered by Gemini API and FSRS",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:both": "node scripts/dev.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:preview": "npm --prefix client run preview",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:test": "npm --prefix server run test",
    "test:e2e": "npx tsx e2e/harness/runAllTests.ts",
    "test:server": "npm --prefix server run test",
    "test": "npm run test:server && npm run test:e2e",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:push": "npm --prefix server run prisma:push",
    "prisma:migrate": "npm --prefix server run prisma:migrate",
    "prisma:seed": "npm --prefix server run prisma:seed",
    "prisma:studio": "npm --prefix server run prisma:studio"
  },
  "keywords": [
    "german",
    "language-learning",
    "gemini-api",
    "fsrs",
    "prisma",
    "sqlite"
  ],
  "author": "Sprachweg Team",
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
