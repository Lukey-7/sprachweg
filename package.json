{
  "name": "sprachweg",
  "version": "1.0.0",
  "private": true,
  "description": "Production-quality German learning platform powered by Gemini API and FSRS",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:both": "node scripts/dev.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:preview": "npm --prefix client run preview",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:test": "npm --prefix server run test",
    "test:e2e": "npx tsx e2e/harness/runAllTests.ts",
    "test:server": "npm --prefix server run test",
    "test": "npm run test:server && npm run test:e2e",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:push:test": "node scripts/with-test-db.mjs prisma db push --skip-generate --schema=prisma/schema.prisma",
    "db:seed": "npm --prefix server run db:seed",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "build": "npm run db:generate && npm --prefix client run build",
    "postinstall": "prisma generate --schema=prisma/schema.prisma"
  },
  "keywords": [
    "german",
    "language-learning",
    "gemini-api",
    "fsrs",
    "prisma",
    "sqlite"
  ],
  "author": "Sprachweg Team",
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  }
}
