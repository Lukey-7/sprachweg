# ── Database (Neon Postgres) ─────────────────────────────────────────────
# Pooled connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct (non-pooled) connection string. Used only by `prisma db push` / migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Separate database the test suite is allowed to WIPE. Never point this at your real data.
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/sprachweg_test"

# ── Gemini ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=""
# true = canned offline responses (no API calls). Leave false once you have a key.
MOCK_GEMINI=false

# ── App ──────────────────────────────────────────────────────────────────
# The single learner row this app uses. Any stable string works.
SPRACHWEG_USER_ID="me"
PORT=4000
